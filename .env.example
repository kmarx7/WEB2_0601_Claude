# Google Sheets 서비스 계정 이메일
# Google Cloud Console > IAM > 서비스 계정 이메일 주소
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google Sheets 서비스 계정 Private Key
# JSON 키 파일의 private_key 값 전체 (BEGIN/END 포함)
# \n을 실제 줄바꿈으로 또는 \\n 이스케이프 문자열로 입력
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheets 스프레드시트 ID
# 스프레드시트 URL에서 /d/ 와 /edit 사이의 값
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 데이터를 저장할 시트 이름 (기본값: Sheet1)
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# ─── 관리자 알림 이메일 (Resend) ─────────────────────────────────────────────
# Resend 대시보드(https://resend.com)에서 발급한 API 키
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 관리자 알림을 받을 이메일 주소
ADMIN_EMAIL=admin@yourdomain.com

# 발신자 이메일 주소 (Resend에서 인증한 도메인이어야 함)
# 테스트 시 onboarding@resend.dev 사용 가능 (본인 이메일로만 발송됨)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── 관리자 페이지 인증 ────────────────────────────────────────────────────────
# /admin 페이지 접근 토큰 (충분히 길고 무작위한 값 사용)
# 예: openssl rand -base64 32
ADMIN_SECRET=your-very-secret-admin-token-here
